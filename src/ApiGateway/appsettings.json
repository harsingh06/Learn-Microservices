{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Information"
    }
  },
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Routes": {
      "candidates-route": {
        "ClusterId": "candidates",
        "Match": { "Path": "/api/candidates/{**catch-all}" },
        "Transforms": [{ "PathRemovePrefix": "/api" }]
      },
      "jobs-route": {
        "ClusterId": "jobs",
        "Match": { "Path": "/api/jobs/{**catch-all}" },
        "Transforms": [{ "PathRemovePrefix": "/api" }]
      },
      "applications-route": {
        "ClusterId": "applications",
        "Match": { "Path": "/api/applications/{**catch-all}" },
        "Transforms": [{ "PathRemovePrefix": "/api" }]
      }
    },
    "Clusters": {
      "candidates": {
        "Destinations": {
          "primary": { "Address": "http://localhost:5101" }
        }
      },
      "jobs": {
        "Destinations": {
          "primary": { "Address": "http://localhost:5102" }
        }
      },
      "applications": {
        "Destinations": {
          "primary": { "Address": "http://localhost:5103" }
        }
      }
    }
  }
}
