# Copy to terraform.tfvars (git-ignored) and fill in.
# Get your subscription id with:  az account show --query id -o tsv
subscription_id = "00000000-0000-0000-0000-000000000000"

# Naming: rg-<workload>-<environment>-<region>-<instance>, e.g. rg-ats-prod-cin-01.
# environment = "prod"
# instance    = "01"

# The site's hostname, held by Front Door (DEPLOY.md, custom domain).
# custom_domain = "ats.harsingh.com"
